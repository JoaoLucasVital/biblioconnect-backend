generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                     Int       @id @default(autoincrement())
  nome                   String
  email                  String    @unique
  senha                  String
  telefone               String?

  endereco               String?
  cep                    String?
  rua                    String?
  bairro                 String?
  cidade                 String?
  estado                 String?
  numero                 String?
  complemento            String?
  pontoReferencia        String?

  role                   String    @default("CLIENTE")
  emailConfirmado        Boolean   @default(false)
  tokenConfirmacaoEmail  String?   @unique
  tokenConfirmacaoExpira DateTime?

  tokenResetSenha        String?   @unique
  tokenResetSenhaExpira  DateTime?

  bloqueado              Boolean   @default(false)
  createdAt              DateTime  @default(now())

  pedidos Pedido[]
}

model Livro {
  id              Int      @id @default(autoincrement())
  titulo          String
  autor           String
  redator         String
  ano             Int
  categoria       String
  sinopse         String
  precoCompra     Float
  precoAluguel    Float
  diasInclusos    Int
  precoDiaExtra   Float
  estoque         Int
  isDoado         Boolean  @default(false)

  imagemUrl       String?

  destaque        Boolean  @default(false)
  disponivel      Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pedidos         Pedido[]
}

model Pedido {
  id                 Int      @id @default(autoincrement())
  tipo               String
  status             String
  statusPagamento    String   @default("pendente")
  valor              Float
  diasAluguel        Int?
  retiradaLimite     DateTime
  devolucaoPrevista  DateTime?
  createdAt          DateTime @default(now())

  usuarioId Int
  livroId   Int

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  livro   Livro   @relation(fields: [livroId], references: [id])
}